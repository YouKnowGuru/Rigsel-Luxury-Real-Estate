# =============================================================================
# Rigsel Real Estate - Environment Configuration
# =============================================================================
# IMPORTANT: Never commit actual secrets to version control.
# Copy this file to .env and fill in real values.
# Generate strong secrets using: openssl rand -base64 32
# =============================================================================

# ---------------------------------------------------------------------------
# MongoDB Connection
# ---------------------------------------------------------------------------
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=

# ---------------------------------------------------------------------------
# JWT Secret (for admin authentication)
# Generate: openssl rand -base64 32
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# NextAuth Configuration
# Generate NEXTAUTH_SECRET: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cloudinary (Image/Document Storage)
# Get from: https://cloudinary.com/console
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# SMTP / Email Configuration (for contact form notifications)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_REJECT_UNAUTHORIZED=true
CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Admin Setup Secret (one-time use for creating first admin)
# Generate: openssl rand -base64 32
# ---------------------------------------------------------------------------
SETUP_SECRET=

# ---------------------------------------------------------------------------
# CORS Allowed Origin (production domain)
# ---------------------------------------------------------------------------
ALLOWED_ORIGIN=https://your-domain.com

# ---------------------------------------------------------------------------
# OpenRouter (Phojaa A1 AI chat on homepage)
# Get API key: https://openrouter.ai/keys
# Model list: https://openrouter.ai/models
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Free tier — routes to free models only (https://openrouter.ai/models?fmt=cards&order=pricing-low-to-high)
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://phojaa95realestate.com
OPENROUTER_SITE_NAME=PHOJAA95 Real Estate

# ---------------------------------------------------------------------------
# Optional: Redis URL (for production rate limiting)
# Format: redis://localhost:6379
# ---------------------------------------------------------------------------
# REDIS_URL=
